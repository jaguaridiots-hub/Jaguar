+    state.market["ema100"] = state.ema100
+    state.market["ema200"] = state.ema200
+
+    state.market["rsi"] = state.rsi
+    state.market["atr"] = state.atr
+    state.market["volume"] = state.volume
+
+    # ======================================
+    # Return Updated State
+    # ======================================
+
+    return state
